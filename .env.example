# WWYD 環境変数の雛形。これを .env に複製して値を入れる（.env はコミットしない）。
# 値の入手方法は docs/detailed-spec/10-manual-tasks.md（N-02）と 12 章 §7.1 を参照。

# Neon Auth の URL（Neon のコンソール「Auth → Configuration」）。本番ブランチ production のもの
VITE_NEON_AUTH_URL=
# Neon Data API の URL（Neon のコンソール「Postgres database → Data API」）
VITE_NEON_DATA_API_URL=

# DB の接続文字列（パスワードを含む）はここに書かない。Claude は Neon CLI（npx neonctl auth）で必要なときだけ取得する。

# Neon Function create-post の Invocation URL（`npx neonctl functions deploy createpost ...` の出力）
VITE_NEON_CREATE_POST_URL=
