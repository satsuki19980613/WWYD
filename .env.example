# WWYD 環境変数の雛形。これを .env に複製して値を入れる（.env はコミットしない）。
# 値の入手方法は docs/detailed-spec/10-manual-tasks.md を参照。

# Supabase プロジェクトの URL（Project Settings > API）
VITE_SUPABASE_URL=
# Supabase の anon（public）キー。フロントエンドに含めてよいのはこのキーだけ
VITE_SUPABASE_ANON_KEY=

# service_role キーはここに書かない。Edge Functions の実行環境に自動で注入される。
