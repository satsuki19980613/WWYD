{
  "$comment": "回答の検証の共有テストベクタ（詳細仕様 05 章 §2.3）。Vitest（packages/core）と pgTAP（supabase/tests）の両方で読み、TS と SQL の判定が一致することを確かめる。size / min_to / max_to は bb。expect は期待するエラーコード（正常なら null）。",
  "vectors": [
    {
      "name": "正常: AA を call 100%",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": null
    },
    {
      "name": "正常: AA を s1 100%、size = min",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": 13,
      "min_to": 13,
      "max_to": 95.7,
      "expect": null
    },
    {
      "name": "正常: 混合と size = max",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": 95.7,
      "min_to": 13,
      "max_to": 95.7,
      "expect": null
    },
    {
      "name": "正常: check のみ",
      "hex": "\\",
      "keys": [
        "check"
      ],
      "size": null,
      "min_to": null,
      "max_to": null,
      "expect": null
    },
    {
      "name": "正常: check と s1（bet）",
      "hex": "\\",
      "keys": [
        "check",
        "s1"
      ],
      "size": 1,
      "min_to": 1,
      "max_to": 85.5,
      "expect": null
    },
    {
      "name": "長さが 675",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "paint_length"
    },
    {
      "name": "長さが 677",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "paint_length"
    },
    {
      "name": "値が 21",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "paint_value"
    },
    {
      "name": "合法でないキー（check）",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "paint_illegal_key"
    },
    {
      "name": "合法でないキー（fold）",
      "hex": "\\",
      "keys": [
        "check",
        "s1"
      ],
      "size": null,
      "min_to": 1,
      "max_to": 85.5,
      "expect": "paint_illegal_key"
    },
    {
      "name": "合法でないキーと合計違反は合法キーの判定が先",
      "hex": "\\",
      "keys": [
        "check",
        "s1"
      ],
      "size": null,
      "min_to": 1,
      "max_to": 85.5,
      "expect": "paint_illegal_key"
    },
    {
      "name": "マスの合計が 15",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "paint_sum"
    },
    {
      "name": "マスの合計が 25",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "paint_sum"
    },
    {
      "name": "塗ったマスがない",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "paint_empty"
    },
    {
      "name": "s1 を含み size が min 未満",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": 12.999,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "size_out_of_range"
    },
    {
      "name": "s1 を含み size が max 超",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": 95.701,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "size_out_of_range"
    },
    {
      "name": "s1 を含み size がない",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": null,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "size_out_of_range"
    },
    {
      "name": "s1 を含まないのに size がある",
      "hex": "\\",
      "keys": [
        "fold",
        "call",
        "s1"
      ],
      "size": 13,
      "min_to": 13,
      "max_to": 95.7,
      "expect": "size_not_allowed"
    }
  ]
}
