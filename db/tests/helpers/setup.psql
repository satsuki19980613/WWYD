-- pgTAP テストの共通ヘルパー（各テストファイルの begin の直後に `\ir helpers/setup.psql` で読む）。
-- すべて pg_temp に作るので、テストのトランザクションとともに消える。

-- テスト用ユーザーの UUID（n = 1, 2, …）
create or replace function pg_temp.uid(n int) returns uuid language sql immutable as $$
  select ('00000000-0000-0000-0000-' || lpad(n::text, 12, '0'))::uuid
$$;

create or replace function pg_temp.create_user(n int) returns uuid language sql as $$
  insert into neon_auth."user" (id, name, email, "emailVerified", "createdAt", "updatedAt")
  values (pg_temp.uid(n), 'test' || n, 'test' || n || '@example.test', false, now(), now()) returning id
$$;

-- ユーザー n としてふるまう（role = authenticated、public.current_uid() = uid(n)）。n = 0 は anonymous（未ログイン）
create or replace function pg_temp.login(n int) returns void language plpgsql as $$
begin
  if n = 0 then
    perform set_config('request.jwt.claims', '{"role":"anonymous"}', true);
    perform set_config('role', 'anonymous', true);
  else
    perform set_config('request.jwt.claims', json_build_object('sub', pg_temp.uid(n), 'role', 'authenticated')::text, true);
    perform set_config('role', 'authenticated', true);
  end if;
end $$;

create or replace function pg_temp.logout() returns void language plpgsql as $$
begin
  perform set_config('role', 'none', true);   -- 接続したロール（DB の所有者）に戻す
  perform set_config('request.jwt.claims', '', true);
end $$;

-- paint を組み立てる: [[idx, fold, check, call, s1], ...]（05 章 §2）
create or replace function pg_temp.paint(cells jsonb) returns bytea language plpgsql as $$
declare
  b bytea := decode(repeat('00', 676), 'hex');
  c jsonb;
  k int;
begin
  for c in select * from jsonb_array_elements(cells) loop
    for k in 0..3 loop
      b := set_byte(b, (c->>0)::int * 4 + k, (c->>(k + 1))::int);
    end loop;
  end loop;
  return b;
end $$;

-- H-S1 スポット 10 / BB の投稿（Edge Function が insert_post に渡す形。04 章 SPOT-02）
create or replace function pg_temp.hs1(title text default 'H-S1') returns jsonb language sql as $$
  select jsonb_build_object(
    'title', title, 'fmt', 'cash', 'hero', 'BTN', 'street', 'turn',
    'effective_stack', 100, 'keys', '["fold","call","s1"]'::jsonb, 's1_label', 'raise',
    'min_to', 13, 'max_to', 95.7, 'pot_base', 22.1,
    'sb', 0.5, 'bb', 1, 'ante', 0, 'rake', 5,
    'stacks', '{"UTG":100,"HJ":100,"CO":100,"BTN":100,"SB":100,"BB":100}'::jsonb,
    'board', '["Kh","8d","3c","2s","7h"]'::jsonb,
    'actions', '[
      {"street":"pf","pos":"UTG","type":"fold"},{"street":"pf","pos":"HJ","type":"fold"},
      {"street":"pf","pos":"CO","type":"fold"},{"street":"pf","pos":"BTN","type":"raise","to":2.5},
      {"street":"pf","pos":"SB","type":"fold"},{"street":"pf","pos":"BB","type":"call"},
      {"street":"flop","pos":"BB","type":"check"},{"street":"flop","pos":"BTN","type":"bet","to":1.8},
      {"street":"flop","pos":"BB","type":"call"},
      {"street":"turn","pos":"BB","type":"check"},{"street":"turn","pos":"BTN","type":"bet","to":6.5},
      {"street":"turn","pos":"BB","type":"call"},
      {"street":"river","pos":"BB","type":"check"},{"street":"river","pos":"BTN","type":"bet","to":15},
      {"street":"river","pos":"BB","type":"call"}]'::jsonb,
    'spot_index', 10, 'stop_index', 11,
    'hero_cards', '["Ad","Kd"]'::jsonb, 'known_cards', '{"BB":["Ks","Js"]}'::jsonb)
$$;

-- 投稿を作る（DB の所有者として insert_post を呼ぶ。Neon Function と同じ）
create or replace function pg_temp.make_post(author int, p jsonb default null) returns uuid language sql as $$
  select public.insert_post(pg_temp.uid(author), coalesce(p, pg_temp.hs1()))
$$;

-- 集計のマス idx のキー k（0 = n_cell、1〜4 = fold, check, call, s1）の値（05 章 §3）
create or replace function pg_temp.agg(post uuid, idx int, k int) returns int language sql as $$
  select get_byte(g.cells, idx * 10 + k * 2) * 256 + get_byte(g.cells, idx * 10 + k * 2 + 1)
  from public.post_aggregates g where g.post_id = post
$$;
