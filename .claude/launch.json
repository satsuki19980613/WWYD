{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app-production",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:prod"
      ],
      "port": 5173
    },
    {
      "name": "app-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "-w",
        "@wwyd/app",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    }
  ]
}
